# Copy this file to .env and fill in your real key.
# The real .env is gitignored and must NEVER be committed. In production, set
# these in the deploy platform's dashboard (Render: Environment tab).

# Your Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used to generate grounded answers (optional; this is the default).
ANTHROPIC_MODEL=claude-sonnet-4-5

# The developer's first name, used in the assistant's voice (optional; default Les).
DEVELOPER_NAME=Les

# The Upwork profile the assistant hands off to (the single contact channel).
UPWORK_URL=https://www.upwork.com/freelancers/~0178a832a97394710e

# Browser origins allowed to call the API (optional; comma-separated). Default "*"
# is fine for a standalone demo (no credentials are ever sent). Lock down if embedding.
# ALLOWED_ORIGINS=https://your-site.com,http://localhost:8000

# Max conversation turns sent to the model (optional; default 24).
# MAX_HISTORY_TURNS=24
